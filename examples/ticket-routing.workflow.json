{
	"name": "TypeSafe ticket routing with review",
	"nodes": [
		{
			"parameters": {
				"content": "## Setup\n1. Add a **TypeSafe AI API** credential to Route with TypeSafe.\n2. Keep route names and their order static: output 1 is Billing, then Technical, Sales, and Review.\n3. Replace each No Operation queue with your helpdesk or approval step.",
				"height": 180,
				"width": 440,
				"color": 5
			},
			"id": "setup-note",
			"name": "Setup",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-500, -300]
		},
		{
			"parameters": {},
			"id": "manual-trigger",
			"name": "Run Example",
			"type": "n8n-nodes-base.manualTrigger",
			"typeVersion": 1,
			"position": [-500, 0]
		},
		{
			"parameters": {
				"assignments": {
					"assignments": [
						{
							"id": "message",
							"name": "message",
							"type": "string",
							"value": "I was charged twice and need a refund today"
						}
					]
				},
				"options": {}
			},
			"id": "sample-ticket",
			"name": "Sample Ticket",
			"type": "n8n-nodes-base.set",
			"typeVersion": 3.4,
			"position": [-280, 0]
		},
		{
			"parameters": {
				"operation": "route",
				"model": "jev-latest",
				"stateInput": "inputItem",
				"decisionType": "choice",
				"routeInstructions": "Which team should handle this support ticket?",
				"choiceRoutes": {
					"routes": [
						{ "name": "Billing", "description": "Payments, invoices, charges, or refunds" },
						{ "name": "Technical", "description": "Bugs, outages, or integration problems" },
						{ "name": "Sales", "description": "Pricing, plans, or purchase questions" }
					]
				},
				"reviewHandling": "review",
				"confidenceThreshold": 0.85,
				"options": {
					"includeRequestId": true,
					"outputField": "decision"
				}
			},
			"id": "typesafe-route",
			"name": "Route with TypeSafe",
			"type": "@itsmeyaw/n8n-nodes-typesafe.typeSafe",
			"typeVersion": 1,
			"position": [-40, 0]
		},
