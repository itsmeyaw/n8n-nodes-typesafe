{
	"name": "TypeSafe AI Agent decision tool",
	"nodes": [
		{
			"parameters": {
				"content": "## Setup\n1. Add your chat-model credential and a **TypeSafe AI API** credential.\n2. The agent calls TypeSafe with the message as `state`; it receives a typed team and urgency decision.\n3. Keep this tool for bounded decisions, not generated replies.",
				"height": 190,
				"width": 490,
				"color": 5
			},
			"id": "setup-note",
			"name": "Setup",
			"type": "n8n-nodes-base.stickyNote",
			"typeVersion": 1,
			"position": [-120, -300]
		},
		{
			"parameters": { "options": {} },
			"id": "chat-trigger",
			"name": "When chat message received",
			"type": "@n8n/n8n-nodes-langchain.chatTrigger",
			"typeVersion": 1.4,
			"position": [-500, 0]
		},
		{
			"parameters": {
				"promptType": "define",
				"text": "={{ $json.chatInput }}",
				"options": {
					"systemMessage": "Use the TypeSafe Decision tool before assigning a support team. State the returned team and urgency probability."
				}
			},
			"id": "ai-agent",
			"name": "Support Agent",
			"type": "@n8n/n8n-nodes-langchain.agent",
			"typeVersion": 3.1,
			"position": [-220, 0]
		},
		{
			"parameters": {
				"model": {
					"__rl": true,
					"mode": "list",
					"value": "gpt-4o-mini",
					"cachedResultName": "gpt-4o-mini"
				},
				"options": {}
			},
			"id": "chat-model",
			"name": "OpenAI Chat Model",
			"type": "@n8n/n8n-nodes-langchain.lmChatOpenAi",
			"typeVersion": 1.3,
			"position": [-260, 220]
		},
		{
			"parameters": {
				"operation": "evaluate",
				"model": "jev-1.13.0",
				"stateInput": "text",
				"stateText": "={{ $fromAI('state', 'The support message to classify', 'string') }}",
				"questionInput": "json",
				"questionsJson": "{\n  \"team\": {\n    \"type\": \"choice\",\n    \"instructions\": \"Which support team should handle this message?\",\n    \"criteria\": {\n      \"Billing\": \"Payments, invoices, charges, or refunds\",\n      \"Technical\": \"Bugs, outages, or integrations\",\n      \"Sales\": \"Pricing, plans, or purchase questions\"\n    }\n  },\n  \"urgent\": {\n    \"type\": \"noul\",\n    \"instructions\": \"Does this require action today?\"\n  }\n}",
				"output": "answersOnly",
				"simplify": true,
				"options": {}
			},
			"id": "typesafe-tool",
			"name": "TypeSafe Decision",
			"type": "@itsmeyaw/n8n-nodes-typesafe.typeSafe",
			"typeVersion": 1,
			"position": [40, 220]
		}
	],
	"pinData": {},
